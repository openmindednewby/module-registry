{
    "name": "@dloizides/module-registry",
    "version": "0.1.1",
    "description": "Typed module manifests for a modular console shell: each module declares its nav group, routes and roles; the registry turns them into role-filtered nav groups and route access checks.",
    "keywords": [
        "module",
        "registry",
        "navigation",
        "roles",
        "manifest",
        "dloizides"
    ],
    "author": "dloizides",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/openmindednewby/module-registry.git"
    },
    "homepage": "https://github.com/openmindednewby/module-registry#readme",
    "bugs": {
        "url": "https://github.com/openmindednewby/module-registry/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "default": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rimraf dist && tsup",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "clean": "rimraf dist",
        "prepublishOnly": "npm run clean && npm run build && npm run test",
        "version": "npm run build"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^20.19.32",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.1.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    }
}
